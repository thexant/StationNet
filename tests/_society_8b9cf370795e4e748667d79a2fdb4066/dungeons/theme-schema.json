{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stationnet.local/schemas/dungeon-theme-v2.json",
  "title": "StationNet dungeon theme",
  "type": "object",
  "required": ["schema_version", "id", "version", "name", "generation", "pools"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"enum": [1, 2], "description": "Schema 2 is required for effects, abilities, rewards, scaling, and bosses."},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "origins": {
      "type": "object",
      "description": "Optional races and classes installed with a theme and offered in the dungeon world.",
      "properties": {
        "races": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "classes": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "maxItems": 100,
      "description": "Optional skills installed with a theme; bundled races and classes may reference them by local key.",
      "items": {"type": "object"}
    },
    "definitions": {
      "type": "object",
      "description": "Portable definitions owned by this theme. Runtime IDs are namespaced by theme ID and version.",
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/itemDefinition"}},
        "npcs": {"type": "array", "items": {"$ref": "#/$defs/npcDefinition"}},
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/enemyDefinition"}}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["size", "difficulty", "layouts"],
      "properties": {
        "size": {"$ref": "#/$defs/range"},
        "difficulty": {"$ref": "#/$defs/range"},
        "layouts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["type"],
            "properties": {
              "type": {"enum": ["linear", "branching", "maze", "hub"]},
              "weight": {"$ref": "#/$defs/weight"}
            }
          }
        },
        "special_roles": {
          "type": "array",
          "items": {
            "type": "object", "required": ["role", "count"],
            "properties": {
              "role": {"$ref": "#/$defs/id"},
              "count": {"type": "integer", "minimum": 1, "maximum": 100},
              "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "prefer_dead_ends": {"type": "boolean"}
            }
          }
        }
      }
    },
    "pools": {
      "type": "object", "required": ["rooms"],
      "properties": {
        "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roomPool"}},
        "environments": {"type": "array", "items": {"$ref": "#/$defs/environmentPool"}},
        "npcs": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "encounters": {"type": "array", "items": {"$ref": "#/$defs/encounterPool"}}
      }
    },
    "triggers": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/trigger"}},
    "effects": {
      "type": "array", "maxItems": 100,
      "description": "Schema 2. Timed effects bundled with the theme.",
      "items": {
        "type": "object", "required": ["key", "name", "kind"], "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 40},
          "description": {"type": "string", "maxLength": 500},
          "kind": {"enum": ["damage", "regen", "attack", "defense", "accuracy", "evasion"]},
          "sign": {"enum": [1, -1]},
          "resist_as": {"enum": ["physical", "poison", "burning", "bleeding", "weakness", "vulnerability", "blinded", "snared"]}
        }
      }
    },
    "abilities": {
      "type": "array", "maxItems": 100,
      "description": "Schema 2. Castable abilities bundled with the theme; bundled classes and races grant them in spells.",
      "items": {
        "type": "object", "required": ["key", "name", "target"], "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 40},
          "command": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$"},
          "description": {"type": "string", "maxLength": 500},
          "target": {"enum": ["enemy", "self"]},
          "cost": {"type": "integer", "minimum": 0, "maximum": 100},
          "damage": {"type": "integer", "minimum": 1, "maximum": 200},
          "heal": {"type": "integer", "minimum": 1, "maximum": 200},
          "effects": {"type": "array", "maxItems": 4, "items": {
            "type": "object", "required": ["key"], "additionalProperties": false,
            "properties": {"key": {"type": "string"},
                           "potency": {"type": "integer", "minimum": 1, "maximum": 1000},
                           "duration": {"type": "integer", "minimum": 1, "maximum": 100}}}}
        }
      }
    },
    "rewards": {
      "type": "object", "additionalProperties": false, "description": "Schema 2.",
      "properties": {
        "experience_percent": {"type": "integer", "minimum": 10, "maximum": 500},
        "risk_loot": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "chance_percent": {"type": "integer", "minimum": 0, "maximum": 200},
            "tiers": {"type": "object", "additionalProperties": false, "patternProperties": {
              "^[123]$": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}}}}
          }
        }
      }
    },
    "scaling": {
      "type": "object", "additionalProperties": false, "description": "Schema 2.",
      "properties": {
        "offset": {"type": "integer", "minimum": 0, "maximum": 10},
        "per_step": {"type": "object", "additionalProperties": false, "properties": {
          "maximum_health": {"type": "number", "minimum": 0, "maximum": 100},
          "attack": {"type": "number", "minimum": 0, "maximum": 20},
          "defense": {"type": "number", "minimum": 0, "maximum": 10},
          "accuracy": {"type": "number", "minimum": 0, "maximum": 10},
          "evasion": {"type": "number", "minimum": 0, "maximum": 10},
          "experience_reward": {"type": "number", "minimum": 0, "maximum": 100}}}
      }
    },
    "bosses": {
      "type": "object", "additionalProperties": false, "description": "Schema 2. Applies to embedded enemies with boss: true.",
      "properties": {
        "health_percent": {"type": "integer", "minimum": 100, "maximum": 500},
        "attack_percent": {"type": "integer", "minimum": 100, "maximum": 300},
        "experience_percent": {"type": "integer", "minimum": 100, "maximum": 500}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "weight": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1},
    "range": {
      "type": "object", "required": ["minimum", "default", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "default": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "layouts": {"type": "array", "minItems": 1, "items": {"enum": ["linear", "branching", "maze", "hub"]}},
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "min_difficulty": {"type": "integer", "minimum": 0},
        "max_difficulty": {"type": "integer", "minimum": 0},
        "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "min_degree": {"type": "integer", "minimum": 0},
        "max_degree": {"type": "integer", "minimum": 0},
        "dead_end": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "itemReference": {
      "type": "object",
      "oneOf": [
        {"required": ["item_local_id"], "not": {"required": ["item_definition_id"]}},
        {"required": ["item_definition_id"], "not": {"required": ["item_local_id"]}}
      ],
      "properties": {
        "item_local_id": {"$ref": "#/$defs/id"},
        "item_definition_id": {"type": "string", "minLength": 1}
      }
    },
    "originKeys": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$"}
    },
    "itemDefinition": {
      "type": "object", "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "item_type": {"enum": ["misc", "equipment", "container", "consumable", "key"]},
        "equipment_slot": {"enum": ["head", "body", "hands", "legs", "feet", "main_hand", "off_hand", "accessory"]},
        "properties": {
          "type": "object",
          "description": "Combat bonuses, consumable effects, and the item's full coin value. Unknown keys are retained for theme-specific data.",
          "properties": {
            "damage": {"type": "integer", "minimum": 0},
            "attack": {"type": "integer", "minimum": 0},
            "attack_bonus": {"type": "integer", "minimum": 0},
            "armor": {"type": "integer", "minimum": 0},
            "defense": {"type": "integer", "minimum": 0},
            "defense_bonus": {"type": "integer", "minimum": 0},
            "heal": {"type": "integer", "minimum": 1},
            "value": {"type": "integer", "minimum": 1, "maximum": 100000},
            "reveal_exit": {"type": "boolean"},
            "use_message": {"type": "string"},
            "requirements": {
              "type": "object",
              "description": "Who may equip the item: attribute minimums, level, and race/class/tag lists. races, classes, and tags pass when any listed key matches; not_races, not_classes, and not_tags fail when any matches.",
              "properties": {
                "strength": {"type": "integer", "minimum": 1, "maximum": 30},
                "agility": {"type": "integer", "minimum": 1, "maximum": 30},
                "intellect": {"type": "integer", "minimum": 1, "maximum": 30},
                "vitality": {"type": "integer", "minimum": 1, "maximum": 30},
                "level": {"type": "integer", "minimum": 1, "maximum": 1000},
                "races": {"$ref": "#/$defs/originKeys"}, "classes": {"$ref": "#/$defs/originKeys"},
                "tags": {"$ref": "#/$defs/originKeys"}, "not_races": {"$ref": "#/$defs/originKeys"},
                "not_classes": {"$ref": "#/$defs/originKeys"}, "not_tags": {"$ref": "#/$defs/originKeys"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "behaviors": {"type": "object"}
      }
    },
    "conversation": {
      "type": "object", "required": ["nodes"],
      "properties": {
        "name": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "body"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "body": {"type": "string", "minLength": 1},
            "start": {"type": "boolean"},
            "responses": {"type": "array", "items": {
              "type": "object", "required": ["id", "text"],
              "properties": {
                "id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1},
                "next_node_id": {"$ref": "#/$defs/id"},
                "required_state_key": {"type": "string"}, "required_state_value": {"type": "string"},
                "state_key": {"type": "string"}, "state_value": {"type": "string"},
                "sort_order": {"type": "integer"},
                "conditions": {"type": "array", "maxItems": 20, "items": {"type": "object"},
                               "description": "All must hold for the response to appear: level, race, class, tag, has_item, coins, attribute, skill, state, claimed; any condition accepts negate, and {\"any\": [...]} groups alternatives. Item IDs may name embedded items."},
                "outcomes": {"type": "array", "maxItems": 10, "items": {
                  "type": "object", "required": ["type"],
                  "properties": {
                    "type": {"enum": ["give_item", "take_item", "experience", "coins", "take_coins"]},
                    "item": {"type": "string"}, "amount": {"type": "integer", "minimum": 1, "maximum": 100000}
                  }
                }, "description": "Granted once per character the first time the response is chosen."}
              }
            }}
          }
        }}
      }
    },
    "combat": {
      "type": "object",
      "properties": {
        "maximum_health": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "attack": {"type": "integer", "minimum": 1, "maximum": 100000},
        "defense": {"type": "integer", "minimum": 0, "maximum": 100000, "description": "Flat damage reduction against attacks that land."},
        "accuracy": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Added to the base 85% chance to hit; grows by 2 per room difficulty step above 2."},
        "evasion": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Subtracted from attackers' chance to hit (half against spells); grows by 1 per room difficulty step above 2."},
        "experience_reward": {"type": "integer", "minimum": 0, "maximum": 100000},
        "respawn_seconds": {"type": "integer", "minimum": 5, "maximum": 86400, "description": "Respawn delay in the traditional world; defeated dungeon enemies remain defeated during a run."}
      }
    },
    "npcDefinition": {
      "type": "object", "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "properties": {"type": "object"},
        "behaviors": {"type": "object", "description": "Combat-capable NPCs attack on entry by default. Set aggressive:false or friendly or neutral to prevent automatic attacks; such NPCs still fight back once attacked. passive:true NPCs never fight back."},
        "conversation": {"$ref": "#/$defs/conversation"}, "combat": {"$ref": "#/$defs/combat"},
        "equipment": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/itemReference"}, {"type": "object", "required": ["slot"], "properties": {"slot": {"enum": ["head", "body", "hands", "legs", "feet", "main_hand", "off_hand", "accessory"]}}}]}},
        "loot": {"type": "array", "items": {"oneOf": [
          {"type": "object", "required": ["type"], "properties": {"type": {"const": "experience"}, "amount": {"type": "integer", "minimum": 1, "maximum": 100000}}},
          {"allOf": [{"$ref": "#/$defs/itemReference"}, {"type": "object", "required": ["type"], "properties": {"type": {"const": "item"}, "amount": {"type": "integer", "minimum": 1, "maximum": 100}}}]}
        ]}}
      }
    },
    "enemyDefinition": {
      "allOf": [{"$ref": "#/$defs/npcDefinition"}, {"type": "object", "required": ["combat"]}]
    },
    "weightedText": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1}, "weight": {"$ref": "#/$defs/weight"}}
      }
    },
    "poolBase": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}
    },
    "roomPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["names", "descriptions"], "properties": {"names": {"$ref": "#/$defs/weightedText"}, "descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "environmentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["descriptions"], "properties": {"descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "contentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["count", "choices"], "properties": {
          "chance": {"type": "number", "minimum": 0, "maximum": 1},
          "count": {"type": "object", "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 100}, "maximum": {"type": "integer", "minimum": 0, "maximum": 100}}},
          "choices": {"type": "array", "minItems": 1, "items": {"type": "object", "oneOf": [{"required": ["definition_id"], "not": {"required": ["local_id"]}}, {"required": ["local_id"], "not": {"required": ["definition_id"]}}], "properties": {"definition_id": {"type": "string", "minLength": 1}, "local_id": {"$ref": "#/$defs/id"}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}}}
        }}
      ]
    },
    "encounterPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "properties": {"chance": {"type": "number", "minimum": 0, "maximum": 1}, "npc_pool": {"$ref": "#/$defs/id"}, "enemy_pool": {"$ref": "#/$defs/id"}, "item_pool": {"$ref": "#/$defs/id"}, "config": {"type": "object"}}}
      ]
    },
    "trigger": {
      "type": "object", "required": ["id", "event", "actions"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "name": {"type": "string", "maxLength": 80},
        "event": {"enum": ["enter_room", "use_object", "take_item", "say_phrase", "defeat_npc", "manual"]},
        "source": {"type": "object", "maxProperties": 1, "additionalProperties": false, "properties": {"room_role": {"type": "string"}, "room_template": {"type": "string"}, "item": {"type": "string"}, "npc": {"type": "string"}}},
        "phrase": {"type": "string", "maxLength": 200},
        "scope": {"enum": ["character", "world"]},
        "once": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "cooldown_seconds": {"type": "integer", "minimum": 0, "maximum": 604800},
        "max_fires": {"type": ["integer", "null"], "minimum": 1},
        "conditions": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
        "fail_message": {"type": "string", "maxLength": 200},
        "actions": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["message", "set_flag", "clear_flag", "give_item", "take_item", "experience", "coins", "take_coins", "heal", "damage", "run_trigger"]}, "delay_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}}}}
      }
    }
  }
}
