{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stationnet.local/schemas/dungeon-theme-v1.json",
  "title": "StationNet dungeon theme",
  "type": "object",
  "required": ["schema_version", "id", "version", "name", "generation", "pools"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "definitions": {
      "type": "object",
      "description": "Portable definitions owned by this theme. Runtime IDs are namespaced by theme ID and version.",
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/itemDefinition"}},
        "npcs": {"type": "array", "items": {"$ref": "#/$defs/npcDefinition"}},
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/enemyDefinition"}}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["size", "difficulty", "layouts"],
      "properties": {
        "size": {"$ref": "#/$defs/range"},
        "difficulty": {"$ref": "#/$defs/range"},
        "layouts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["type"],
            "properties": {
              "type": {"enum": ["linear", "branching", "maze", "hub"]},
              "weight": {"$ref": "#/$defs/weight"}
            }
          }
        },
        "special_roles": {
          "type": "array",
          "items": {
            "type": "object", "required": ["role", "count"],
            "properties": {
              "role": {"$ref": "#/$defs/id"},
              "count": {"type": "integer", "minimum": 1, "maximum": 100},
              "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "prefer_dead_ends": {"type": "boolean"}
            }
          }
        }
      }
    },
    "pools": {
      "type": "object", "required": ["rooms"],
      "properties": {
        "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roomPool"}},
        "environments": {"type": "array", "items": {"$ref": "#/$defs/environmentPool"}},
        "npcs": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "encounters": {"type": "array", "items": {"$ref": "#/$defs/encounterPool"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "weight": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1},
    "range": {
      "type": "object", "required": ["minimum", "default", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "default": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "layouts": {"type": "array", "minItems": 1, "items": {"enum": ["linear", "branching", "maze", "hub"]}},
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "min_difficulty": {"type": "integer", "minimum": 0},
        "max_difficulty": {"type": "integer", "minimum": 0},
        "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "min_degree": {"type": "integer", "minimum": 0},
        "max_degree": {"type": "integer", "minimum": 0},
        "dead_end": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "itemReference": {
      "type": "object",
      "oneOf": [
        {"required": ["item_local_id"], "not": {"required": ["item_definition_id"]}},
        {"required": ["item_definition_id"], "not": {"required": ["item_local_id"]}}
      ],
      "properties": {
        "item_local_id": {"$ref": "#/$defs/id"},
        "item_definition_id": {"type": "string", "minLength": 1}
      }
    },
    "itemDefinition": {
      "type": "object", "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "item_type": {"enum": ["misc", "equipment", "container", "consumable", "key"]},
        "equipment_slot": {"enum": ["head", "body", "hands", "legs", "feet", "main_hand", "off_hand", "accessory"]},
        "properties": {
          "type": "object",
          "description": "Combat bonuses, consumable effects, and the item's full coin value. Unknown keys are retained for theme-specific data.",
          "properties": {
            "damage": {"type": "integer", "minimum": 0},
            "attack": {"type": "integer", "minimum": 0},
            "attack_bonus": {"type": "integer", "minimum": 0},
            "armor": {"type": "integer", "minimum": 0},
            "defense": {"type": "integer", "minimum": 0},
            "defense_bonus": {"type": "integer", "minimum": 0},
            "heal": {"type": "integer", "minimum": 1},
            "value": {"type": "integer", "minimum": 1, "maximum": 100000},
            "reveal_exit": {"type": "boolean"},
            "use_message": {"type": "string"}
          },
          "additionalProperties": true
        },
        "behaviors": {"type": "object"}
      }
    },
    "conversation": {
      "type": "object", "required": ["nodes"],
      "properties": {
        "name": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "body"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "body": {"type": "string", "minLength": 1},
            "start": {"type": "boolean"},
            "responses": {"type": "array", "items": {
              "type": "object", "required": ["id", "text"],
              "properties": {
                "id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1},
                "next_node_id": {"$ref": "#/$defs/id"},
                "required_state_key": {"type": "string"}, "required_state_value": {"type": "string"},
                "state_key": {"type": "string"}, "state_value": {"type": "string"},
                "sort_order": {"type": "integer"}
              }
            }}
          }
        }}
      }
    },
    "combat": {
      "type": "object",
      "properties": {
        "maximum_health": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "attack": {"type": "integer", "minimum": 1, "maximum": 100000},
        "defense": {"type": "integer", "minimum": 0, "maximum": 100000},
        "experience_reward": {"type": "integer", "minimum": 0, "maximum": 100000},
        "respawn_seconds": {"type": "integer", "minimum": 5, "maximum": 86400, "description": "Respawn delay in the traditional world; defeated dungeon enemies remain defeated during a run."}
      }
    },
    "npcDefinition": {
      "type": "object", "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "properties": {"type": "object"},
        "behaviors": {"type": "object", "description": "Combat-capable NPCs attack on entry by default. Set aggressive:false or friendly, neutral, or passive:true to prevent automatic attacks."},
        "conversation": {"$ref": "#/$defs/conversation"}, "combat": {"$ref": "#/$defs/combat"},
        "equipment": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/itemReference"}, {"type": "object", "required": ["slot"], "properties": {"slot": {"enum": ["head", "body", "hands", "legs", "feet", "main_hand", "off_hand", "accessory"]}}}]}},
        "loot": {"type": "array", "items": {"oneOf": [
          {"type": "object", "required": ["type"], "properties": {"type": {"const": "experience"}, "amount": {"type": "integer", "minimum": 1, "maximum": 100000}}},
          {"allOf": [{"$ref": "#/$defs/itemReference"}, {"type": "object", "required": ["type"], "properties": {"type": {"const": "item"}, "amount": {"type": "integer", "minimum": 1, "maximum": 100}}}]}
        ]}}
      }
    },
    "enemyDefinition": {
      "allOf": [{"$ref": "#/$defs/npcDefinition"}, {"type": "object", "required": ["combat"]}]
    },
    "weightedText": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1}, "weight": {"$ref": "#/$defs/weight"}}
      }
    },
    "poolBase": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}
    },
    "roomPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["names", "descriptions"], "properties": {"names": {"$ref": "#/$defs/weightedText"}, "descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "environmentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["descriptions"], "properties": {"descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "contentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["count", "choices"], "properties": {
          "chance": {"type": "number", "minimum": 0, "maximum": 1},
          "count": {"type": "object", "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 100}, "maximum": {"type": "integer", "minimum": 0, "maximum": 100}}},
          "choices": {"type": "array", "minItems": 1, "items": {"type": "object", "oneOf": [{"required": ["definition_id"], "not": {"required": ["local_id"]}}, {"required": ["local_id"], "not": {"required": ["definition_id"]}}], "properties": {"definition_id": {"type": "string", "minLength": 1}, "local_id": {"$ref": "#/$defs/id"}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}}}
        }}
      ]
    },
    "encounterPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "properties": {"chance": {"type": "number", "minimum": 0, "maximum": 1}, "npc_pool": {"$ref": "#/$defs/id"}, "enemy_pool": {"$ref": "#/$defs/id"}, "item_pool": {"$ref": "#/$defs/id"}, "config": {"type": "object"}}}
      ]
    }
  }
}
