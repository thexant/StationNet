{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stationnet.local/schemas/dungeon-theme-v1.json",
  "title": "StationNet dungeon theme",
  "type": "object",
  "required": ["schema_version", "id", "version", "name", "generation", "pools"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "generation": {
      "type": "object",
      "required": ["size", "difficulty", "layouts"],
      "properties": {
        "size": {"$ref": "#/$defs/range"},
        "difficulty": {"$ref": "#/$defs/range"},
        "layouts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["type"],
            "properties": {
              "type": {"enum": ["linear", "branching", "maze", "hub"]},
              "weight": {"$ref": "#/$defs/weight"}
            }
          }
        },
        "special_roles": {
          "type": "array",
          "items": {
            "type": "object", "required": ["role", "count"],
            "properties": {
              "role": {"$ref": "#/$defs/id"},
              "count": {"type": "integer", "minimum": 1, "maximum": 100},
              "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "prefer_dead_ends": {"type": "boolean"}
            }
          }
        }
      }
    },
    "pools": {
      "type": "object", "required": ["rooms"],
      "properties": {
        "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roomPool"}},
        "environments": {"type": "array", "items": {"$ref": "#/$defs/environmentPool"}},
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/contentPool"}},
        "encounters": {"type": "array", "items": {"$ref": "#/$defs/encounterPool"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "weight": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1},
    "range": {
      "type": "object", "required": ["minimum", "default", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "default": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "layouts": {"type": "array", "minItems": 1, "items": {"enum": ["linear", "branching", "maze", "hub"]}},
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "min_difficulty": {"type": "integer", "minimum": 0},
        "max_difficulty": {"type": "integer", "minimum": 0},
        "min_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_depth_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "min_degree": {"type": "integer", "minimum": 0},
        "max_degree": {"type": "integer", "minimum": 0},
        "dead_end": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "weightedText": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1}, "weight": {"$ref": "#/$defs/weight"}}
      }
    },
    "poolBase": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}
    },
    "roomPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["names", "descriptions"], "properties": {"names": {"$ref": "#/$defs/weightedText"}, "descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "environmentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["descriptions"], "properties": {"descriptions": {"$ref": "#/$defs/weightedText"}}}
      ]
    },
    "contentPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "required": ["count", "choices"], "properties": {
          "chance": {"type": "number", "minimum": 0, "maximum": 1},
          "count": {"type": "object", "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 100}, "maximum": {"type": "integer", "minimum": 0, "maximum": 100}}},
          "choices": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["definition_id"], "properties": {"definition_id": {"type": "string", "minLength": 1}, "weight": {"$ref": "#/$defs/weight"}, "conditions": {"$ref": "#/$defs/conditions"}}}}
        }}
      ]
    },
    "encounterPool": {
      "allOf": [
        {"$ref": "#/$defs/poolBase"},
        {"type": "object", "properties": {"chance": {"type": "number", "minimum": 0, "maximum": 1}, "enemy_pool": {"$ref": "#/$defs/id"}, "item_pool": {"$ref": "#/$defs/id"}, "config": {"type": "object"}}}
      ]
    }
  }
}
